# --- System / OS ---
.DS_Store
Thumbs.db
*.swp
desktop.ini

# --- Dependencies ---
# ALWAYS commit lockfiles (package-lock.json or yarn.lock) to ensure 
# deterministic builds across the team and CI/CD.
node_modules/
.pnpm-store/

# --- Build & Output ---
dist/
build/
out/
.next/
.cache/
*.tsbuildinfo

# --- Environment & Secrets ---
# Block all actual secret files
.env
.env.local
.env.*.local
*.pem
*.key

# DO NOT ignore .env.example - this serves as the contract for the team
!.env.example

# --- Logs & Debugging ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.eslintcache
.stylelintcache

# --- Editor / IDE ---
# We ignore the workspace settings but can keep recommended extensions/launch configs
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
backend/package-lock.json
frontend/package-lock.json
